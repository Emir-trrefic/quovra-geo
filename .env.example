# Optional: enables the "AI Mention Probe" (asks Claude buyer-style questions
# and checks whether your brand is recommended). The free audit works without it.
ANTHROPIC_API_KEY=

# Optional: lets the probe ask ChatGPT (OpenAI Responses API with web search).
# Set either key or both; when both are set, users pick the engine.
OPENAI_API_KEY=
# QUOVRA_OPENAI_MODEL=gpt-5-mini
# The probe costs API credit per run, so it is off for anonymous visitors (a paid feature).
# Set to 1 to let anyone run it on this server, e.g. while testing locally.
# QUOVRA_PROBE_PUBLIC=1

# Requests per IP per hour for the public API (in-memory limiter).
RATE_LIMIT_PER_HOUR=20

# Where upgrade / waitlist sign-ups are sent (JSON POST). Works with Zapier,
# Make, n8n, Google Apps Script, etc.
LEAD_WEBHOOK_URL=

# Public URL of your deployment (used for metadata, badges and share links).
NEXT_PUBLIC_SITE_URL=https://quovra.app

# How many times each AI Mention Probe question is asked (1-5). More runs give
# tighter confidence intervals at a proportionally higher API cost.
QUOVRA_PROBE_RUNS=3
